/* =========================
   VERIFICATION ELEMENTS
========================= */

const verifyCard=verifyPopup.querySelector(".card");
const verifyClose=verifyPopup.querySelector(".close");
const verifyMessage=verifyPopup.querySelector(".message");

const verifyInputs=[
  ...verifyPopup.querySelectorAll(".inputs input")
];


/* =========================================================
   MAIN CRYPTO SIGNAL PRO 100
   ONLY STARTS AFTER CORRECT CODE
========================================================= */

function startCryptoSignalPro100(){

  /* =========================
     ACTIVE GUARD
  ========================= */

  if(window.__CRYPTO_SIGNAL_PRO_100_ACTIVE__){
    return console.warn(
      "Crypto Signal Pro 100 already running."
    );
  }

  window.__CRYPTO_SIGNAL_PRO_100_ACTIVE__=1;


  /* =========================
     SETTINGS
  ========================= */

  const KEY="crypto_signal_pro_100_settings_v8";
  const DEF={
    delaySec:0,
    direction:"random"
  };

  let S={...DEF};

  try{
    S={
      ...DEF,
      ...JSON.parse(
        localStorage.getItem(KEY)||"{}"
      )
    };
  }catch{}

  S.delaySec=Math.max(
    0,
    Math.min(
      30,
      +S.delaySec||0
    )
  );

  if(!["up","down","random"].includes(S.direction)){
    S.direction="random";
  }


  /* =========================
     REMOVE OLD
  ========================= */

  document.getElementById("tsx")?.remove();
  document.getElementById("ov")?.remove();
  document.getElementById("bd")?.remove();
  document.getElementById("p")?.remove();
  document.getElementById("tsxStyle")?.remove();


  /* =========================
     CSS
  ========================= */

  const st=document.createElement("style");
  st.id="tsxStyle";

  st.textContent=`

#tsx{
  position:fixed;
  z-index:2147483647;
  left:16px;
  top:50%;
  transform:translateY(-50%);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4px;
  cursor:grab;
  user-select:none;
  -webkit-user-select:none;
  touch-action:none;
  filter:drop-shadow(0 2px 6px #000);
}

#tsx:active{
  cursor:grabbing;
}

#tsx .bot-badge{
  width:52px;
  height:52px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:radial-gradient(circle at 30% 25%, #2a1d08, #0c0905 75%);
  border:2px solid #facc15;
  box-shadow:
    0 0 12px rgba(250,204,21,.55),
    inset 0 0 10px rgba(250,204,21,.25);
  animation:tsxFloat 2.4s ease-in-out infinite, tsxGlow 2.4s ease-in-out infinite;
  pointer-events:none;
}

#tsx .bot-badge svg{
  width:44px;
  height:44px;
  display:block;
}

@keyframes tsxFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-4px)}
}

@keyframes tsxGlow{
  0%,100%{
    box-shadow:
      0 0 10px rgba(250,204,21,.45),
      inset 0 0 8px rgba(250,204,21,.2);
  }
  50%{
    box-shadow:
      0 0 20px rgba(250,204,21,.9),
      inset 0 0 14px rgba(250,204,21,.45);
  }
}

#tsx b{
  font:700 10px system-ui,sans-serif;
  background:linear-gradient(90deg, #fef08a 0%, #facc15 45%, #ffffff 70%, #facc15 100%);
  background-size:200% auto;
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  white-space:nowrap;
  filter:drop-shadow(0 1px 2px #000);
  animation:tsxNameShimmer 2.6s linear infinite, tsxNamePulse 2.4s ease-in-out infinite;
  pointer-events:none;
}

@keyframes tsxNameShimmer{
  0%{background-position:0% center}
  100%{background-position:200% center}
}

@keyframes tsxNamePulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.05)}
}

#ov{
  position:fixed;
  inset:0;
  z-index:2147483646;
  display:none;
  pointer-events:none;
}

#ov.on{
  display:block;
}

#ln{
  position:absolute;
  left:0;
  top:-8%;
  width:100%;
  height:6px;
  border-radius:10px;
  background:#a855f7;
  box-shadow:
    0 0 12px #a855f7,
    0 0 25px #a855f7,
    0 0 45px #7c3aed,
    0 0 65px #6d28d9;
  opacity:1;
}

#ln.go{
  animation:tsxLine 1.2s linear;
}

@keyframes tsxLine{
  from{top:-8%}
  to{top:108%}
}

#bd{
  position:fixed;
  inset:0;
  z-index:2147483647;
  background:#0008;
  display:none;
}

#bd.on{
  display:block;
}

#p{
  position:fixed;
  z-index:2147483648;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:min(300px,calc(100vw - 32px));
  padding:16px;
  border-radius:14px;
  background:#100b16;
  color:#fff;
  border:1px solid #9400ff;
  display:none;
  font:14px system-ui,sans-serif;
  box-shadow:0 10px 40px #000;
}

#p.on{
  display:block;
}

#p h3{
  text-align:center;
  color:#b066ff;
  margin:0 0 14px;
}

#p label{
  display:block;
  margin-top:8px;
}

#p input,
#p button{
  box-sizing:border-box;
  width:100%;
  padding:10px;
  margin:5px 0;
  border-radius:8px;
  border:1px solid #5d2780;
  background:#18101f;
  color:#fff;
  font:inherit;
}

#p button{
  cursor:pointer;
}

#p button.sel{
  border-color:#b066ff;
  background:#3b1654;
}

`;

  document.head.appendChild(st);


  /* =========================
     LINE
  ========================= */

  const ov=document.createElement("div");
  ov.id="ov";
  ov.innerHTML='<div id="ln"></div>';
  document.body.appendChild(ov);

  const ln=ov.querySelector("#ln");


  /* =========================
     BACKDROP
  ========================= */

  const bd=document.createElement("div");
  bd.id="bd";
  document.body.appendChild(bd);


  /* =========================
     SETTINGS
  ========================= */

  const p=document.createElement("div");
  p.id="p";

  p.innerHTML=`

<h3>Crypto Signal Pro 100 Settings</h3>

<label>Start delay (seconds)</label>

<input
  id="d"
  type="number"
  min="0"
  max="30"
  step="1"
>

<label>Trade direction</label>

<button data-x="up">Up</button>
<button data-x="down">Down</button>
<button data-x="random">Random</button>

<button id="save">Save</button>

`;

  document.body.appendChild(p);


  /* =========================
     ANIMATED EMBLEM ICON
  ========================= */

  const w=document.createElement("div");
  w.id="tsx";

  w.innerHTML=`
<div class="bot-badge">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <defs>
      <linearGradient id="csGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#fef08a"/>
        <stop offset="50%" stop-color="#facc15"/>
        <stop offset="100%" stop-color="#ca8a04"/>
      </linearGradient>
    </defs>
    <circle cx="32" cy="32" r="29" fill="none" stroke="url(#csGold)" stroke-width="2.5"/>
    <path d="M16 24 L22 13 L32 21 L42 13 L48 24 Z" fill="url(#csGold)"/>
    <circle cx="22" cy="11" r="2.2" fill="#fef08a"/>
    <circle cx="32" cy="9.5" r="2.4" fill="#fef08a"/>
    <circle cx="42" cy="11" r="2.2" fill="#fef08a"/>
    <path d="M18 33 Q32 27 46 33 L44 45 Q32 54 20 45 Z" fill="#181208" stroke="url(#csGold)" stroke-width="2"/>
    <path d="M20 34 L13 27 M44 34 L51 27" stroke="url(#csGold)" stroke-width="2.4" stroke-linecap="round"/>
    <circle cx="27" cy="38" r="2" fill="#fef08a"/>
    <circle cx="37" cy="38" r="2" fill="#fef08a"/>
    <path d="M28 45 L32 49 L36 45" fill="none" stroke="url(#csGold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>
<b>Crypto Signal Pro 100</b>
`;

  document.body.appendChild(w);


  /* =========================
     VARIABLES
  ========================= */

  const d=p.querySelector("#d");
  const bs=p.querySelectorAll("[data-x]");

  let taps=0;
  let last=0;
  let timer=null;
  let active=0;

  let drag=0;
  let moved=0;

  let sx=0;
  let sy=0;
  let sl=0;
  let stp=0;

  let mt=null;


  /* =========================
     UI
  ========================= */

  function ui(){

    d.value=S.delaySec;

    bs.forEach(b=>{
      b.classList.toggle(
        "sel",
        b.dataset.x===S.direction
      );
    });

  }


  /* =========================
     CLOSE SETTINGS
  ========================= */

  function close(){

    p.classList.remove("on");
    bd.classList.remove("on");

  }


  /* =========================
     SAVE SETTINGS
  ========================= */

  function save(){

    S.delaySec=Math.max(
      0,
      Math.min(
        30,
        Math.round(+d.value||0)
      )
    );

    S.direction=
      [...bs].find(
        b=>b.classList.contains("sel")
      )?.dataset.x||"random";

    try{

      localStorage.setItem(
        KEY,
        JSON.stringify(S)
      );

    }catch{}

    close();
    ui();

  }


  /* =========================
     SETTINGS BUTTONS
  ========================= */

  bs.forEach(b=>{

    b.onclick=e=>{

      e.stopPropagation();

      bs.forEach(x=>{
        x.classList.remove("sel");
      });

      b.classList.add("sel");

    };

  });


  p.querySelector("#save").onclick=e=>{
    e.stopPropagation();
    save();
  };

  bd.onclick=close;

  ui();


  /* =========================
     TRADE BUTTONS
  ========================= */

  function buttons(){

    const r=document.getElementById("trade-button");

    if(!r)return[];

    return[
      r.querySelector("button.JQZcs"),
      r.querySelector("button.twQq3")
    ];

  }


  /* =========================
     TRADE
  ========================= */

  function trade(){

    const [up,down]=buttons();

    const pool=[
      up,
      down
    ].filter(Boolean);

    if(!pool.length){

      console.warn(
        "Crypto Signal Pro 100: trade buttons not found."
      );

      return;
    }

    let a;

    if(S.direction==="up")
      a=up;

    else if(S.direction==="down")
      a=down;

    else
      a=pool[
        Math.floor(
          Math.random()*pool.length
        )
      ];

    a?.click();

  }


  /* =========================
     STOP
  ========================= */

  function stop(){

    active=0;

    ov.classList.remove("on");

    ln.classList.remove("go");

    clearTimeout(mt);

    mt=null;

  }


  /* =========================
     START
  ========================= */

  function start(){

    if(active)return;

    active=1;

    ov.classList.add("on");

    let n=0;

    mt=setTimeout(function f(){

      if(!active)return;

      if(n<3){

        ln.classList.remove("go");

        void ln.offsetWidth;

        ln.classList.add("go");

        n++;

        mt=setTimeout(
          f,
          1200
        );

      }else{

        trade();

        stop();

      }

    },S.delaySec*1000);

  }


  /* =========================
     TAP
  ========================= */

  function tap(){

    if(p.classList.contains("on"))
      return;

    const n=Date.now();

    if(n-last>600)
      taps=0;

    last=n;

    taps++;

    clearTimeout(timer);

    if(taps>=3){

      taps=0;

      ui();

      p.classList.add("on");
      bd.classList.add("on");

      return;
    }

    timer=setTimeout(()=>{

      if(taps===1){

        if(active)
          stop();
        else
          start();

      }

      taps=0;

    },220);

  }


  /* =========================
     POSITION
  ========================= */

  function pos(x,y){

    const r=w.getBoundingClientRect();

    const l=Math.max(
      0,
      Math.min(
        sl+x-sx,
        innerWidth-r.width
      )
    );

    const t=Math.max(
      0,
      Math.min(
        stp+y-sy,
        innerHeight-r.height
      )
    );

    w.style.left=l+"px";
    w.style.top=t+"px";
    w.style.transform="none";

  }


  /* =========================
     POINTER DOWN
  ========================= */

  w.addEventListener(
    "pointerdown",
    e=>{

      if(
        e.pointerType==="mouse" &&
        e.button!==0
      )return;

      e.preventDefault();
      e.stopPropagation();

      drag=1;
      moved=0;

      sx=e.clientX;
      sy=e.clientY;

      const r=w.getBoundingClientRect();

      sl=r.left;
      stp=r.top;

      try{
        w.setPointerCapture(
          e.pointerId
        );
      }catch{}

    },
    {passive:false}
  );


  /* =========================
     POINTER MOVE
  ========================= */

  w.addEventListener(
    "pointermove",
    e=>{

      if(!drag)return;

      e.preventDefault();

      if(
        Math.abs(e.clientX-sx)>8 ||
        Math.abs(e.clientY-sy)>8
      ){
        moved=1;
      }

      if(moved){

        pos(
          e.clientX,
          e.clientY
        );

      }

    },
    {passive:false}
  );


  /* =========================
     POINTER UP
  ========================= */

  w.addEventListener(
    "pointerup",
    e=>{

      e.preventDefault();
      e.stopPropagation();

      if(!moved)
        tap();

      drag=0;

      try{
        w.releasePointerCapture(
          e.pointerId
        );
      }catch{}

    },
    {passive:false}
  );


  /* =========================
     POINTER CANCEL
  ========================= */

  w.addEventListener(
    "pointercancel",
    ()=>{
      drag=0;
      moved=0;
    }
  );


  /* =========================
     BLOCK CLICK
  ========================= */

  w.addEventListener(
    "click",
    e=>{
      e.preventDefault();
      e.stopPropagation();
    }
  );


  /* =========================
     GLOBAL STOP
  ========================= */

  window.__CRYPTO_SIGNAL_PRO_100_STOP__=()=>{

    stop();

    clearTimeout(timer);

    w.remove();
    ov.remove();
    bd.remove();
    p.remove();
    st.remove();

    delete window.__CRYPTO_SIGNAL_PRO_100_ACTIVE__;
    delete window.__CRYPTO_SIGNAL_PRO_100_STOP__;

  };


  console.log(
    "Crypto Signal Pro 100 loaded - Verified"
  );

}


/* =========================================================
   VERIFICATION LOGIC
========================================================= */

verifyClose.addEventListener("click",e=>{

  e.preventDefault();
  e.stopPropagation();

  verifyMessage.textContent=
    "Enter the correct code";

  verifyMessage.style.color="#888";

});

verifyPopup.addEventListener("click",e=>{

  if(e.target===verifyPopup){

    e.preventDefault();
    e.stopPropagation();

  }

});

function checkCode(){

  if(!verifyInputs.every(input=>input.value)){
    return;
  }

  const code=verifyInputs
    .map(input=>input.value)
    .join("");

  if(code==="0000"){

    verifyInputs.forEach(input=>{
      input.classList.add("success");
    });

    verifyCard.classList.add("success");

    verifyMessage.textContent="✓ Verified";
    verifyMessage.style.color="#0faf59";

    setTimeout(()=>{

      verifyCard.classList.add("hide");

      setTimeout(()=>{

        verifyPopup.remove();
        verifyStyle.remove();

        startCryptoSignalPro100();

      },450);

    },550);

  }else{

    verifyCard.classList.remove("shake");

    void verifyCard.offsetWidth;

    verifyCard.classList.add("shake");

    verifyMessage.textContent="Wrong code";
    verifyMessage.style.color="#e7473f";

    setTimeout(()=>{

      verifyInputs.forEach(input=>{
        input.value="";
        input.classList.remove("success");
      });

      verifyMessage.textContent="";

      verifyInputs[0].focus();

    },400);

  }

}

verifyInputs.forEach((input,index)=>{

  input.addEventListener("input",()=>{

    input.value=
      input.value.replace(/[^0-9]/g,"");

    if(
      input.value &&
      index<verifyInputs.length-1
    ){

      verifyInputs[index+1].focus();

    }

    checkCode();

  });

  input.addEventListener("keydown",e=>{

    if(
      e.key==="Backspace" &&
      !input.value &&
      index>0
    ){

      verifyInputs[index-1].focus();

    }

  });

  input.addEventListener("keydown",e=>{

    if(
      e.key==="ArrowLeft" &&
      index>0
    ){

      verifyInputs[index-1].focus();

    }

  });

  input.addEventListener("keydown",e=>{

    if(
      e.key==="ArrowRight" &&
      index<verifyInputs.length-1
    ){

      verifyInputs[index+1].focus();

    }

  });

});

verifyInputs[0].addEventListener(
  "paste",
  e=>{

    e.preventDefault();

    const pasted=
      (e.clipboardData||window.clipboardData)
        .getData("text")
        .replace(/\D/g,"")
        .slice(0,4);

    pasted.split("").forEach(
      (digit,i)=>{

        if(verifyInputs[i]){
          verifyInputs[i].value=digit;
        }

      }
    );

    if(pasted.length===4){

      verifyInputs[3].focus();

      checkCode();

    }else{

      verifyInputs[
        Math.min(pasted.length,3)
      ].focus();

    }

  }
);

verifyInputs[0].focus();

})();
